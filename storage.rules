rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if the request is from an authenticated user
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the authenticated user has verified administrator authorization via custom claims
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // Public visitors can read assets (images, PDFs, icons)
    // Only verified administrators can upload, replace, or delete media items
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
