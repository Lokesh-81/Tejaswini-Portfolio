rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if the request is from an authenticated user
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the authenticated user has verified administrator authorization
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'poosala15@gmail.com' ||
          request.auth.token.email.lower() == 'tejaswinitejp@gmail.com' ||
          request.auth.token.email.lower() == 'tejaswiniteja793@gmail.com' ||
          request.auth.token.email.lower() == 'admin@tejaswini.ai'
        ))
      );
    }

    // Public visitors can read assets (images, PDFs, icons)
    // Only verified administrators can upload, replace, or delete media items
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
